# Copy to `.env`, fill in, then `docker compose up` (or pass
# individually with `docker run --env`). Anything starting with
# `#` is a comment; blank lines are ignored.

# === REQUIRED — Claude Max OAuth credentials =====================

# Access token for the Anthropic OAuth flow (the same one Claude
# Code stores locally in ~/.claude/.credentials.json under
# claudeAiOauth.accessToken). The worker materializes that file at
# startup so Claude Code authenticates against the model API.
#
# To pull yours from your existing local install:
#   cat ~/.claude/.credentials.json | jq -r '.claudeAiOauth.accessToken'
#
# Token format starts with `sk-ant-oat01-…`.
ANTHROPIC_ACCESS_TOKEN=

# Refresh token (sk-ant-ort01-…). OPTIONAL but strongly recommended
# for any long-running worker — without it, Claude Code can't auto-
# renew when the access token expires (~14 days). Pull from:
#   cat ~/.claude/.credentials.json | jq -r '.claudeAiOauth.refreshToken'
ANTHROPIC_REFRESH_TOKEN=

# Unix-ms expiry of the access token. Optional; defaults to a
# far-future value so Claude doesn't proactively refresh on a
# stale-looking timestamp.
#   cat ~/.claude/.credentials.json | jq -r '.claudeAiOauth.expiresAt'
ANTHROPIC_TOKEN_EXPIRES_AT=

# Subscription metadata. Defaults match a Claude Max account. Only
# override if you're on a different tier.
ANTHROPIC_SUBSCRIPTION_TYPE=max
ANTHROPIC_RATE_LIMIT_TIER=default_claude_max_20x

# === OPTIONAL: clawborrator hub integration ======================

# Channel token (ck_live_…) — mint via `claw token mint --kind=channel
# --name=worker-N --mcp-snippet`. If set, the worker writes a
# .mcp.json with the token and starts Claude with the
# --dangerously-load-development-channels flag so the clawborrator
# MCP can register the session with the hub.
#
# Leave blank to run a standalone Claude Code with no remote
# control.
CLAWBORRATOR_TOKEN=

# Hub URL the channel MCP dials out to. Default points at the
# hosted v1 hub.
CLAWBORRATOR_HUB_URL=wss://next.clawborrator.com

# === OPTIONAL: workspace bootstrap ===============================

# Git URL — cloned into /workspace on first run only. Skipped on
# subsequent runs if /workspace already has a .git directory.
# Plain URL (no embedded credentials); for private repos add
# REPO_PAT below and the entrypoint will splice it in at clone time.
#   Examples:
#     https://github.com/owner/repo.git
#     https://gitlab.com/owner/repo.git
REPO_URL=

# Branch / tag / sha to checkout after clone. Ignored when REPO_URL
# is unset.
REPO_REF=

# Personal access token for cloning private repos. If set, the
# entrypoint rewrites REPO_URL to
#   https://${REPO_PAT_USER}:${REPO_PAT}@<host>/<path>
# right before `git clone`. Leave blank for public repos.
#
# GitHub: create at https://github.com/settings/tokens (classic with
# `repo` scope) or https://github.com/settings/personal-access-tokens/new
# (fine-grained, scoped to specific repos). Fine-grained is preferred.
# GitLab: User Settings → Access Tokens → `read_repository` scope.
#
# IMPORTANT — security caveat: the PAT-bearing URL persists in
# /workspace/.git/config after clone (so subsequent fetch/push from
# inside CC still work). Anyone with shell access to the container
# or to the bind-mounted volume can read it. Treat container access
# as PAT-equivalent; mint a token with the narrowest scope you can.
REPO_PAT=

# Username paired with REPO_PAT. Default `x-access-token` works for
# both GitHub classic PATs and fine-grained tokens. For GitLab,
# `oauth2`. For self-hosted Gitea, your username.
REPO_PAT_USER=x-access-token

# Subdirectory under /workspace where REPO_URL gets cloned. Default
# `repo`. Claude's cwd is /workspace (NOT the repo) — this keeps
# .mcp.json, .claude/, and CLAUDE.md (worker plumbing) physically
# separate from the repo's working tree. To do git ops from claude:
# `cd repo` or `git -C repo …`.
REPO_DIR_NAME=repo

# Git identity for commits made inside the worker. Without these,
# the first commit fails with `Please tell me who you are…` and
# claude burns a turn running `git config user.email/name` itself.
# Entrypoint runs `git config --global` from these on each boot.
#
# Use a real email on commits that will be pushed (otherwise github
# / gitlab won't link them to your account). For throwaway sandbox
# workers, anything resembling user@host is fine.
GIT_USER_EMAIL=
GIT_USER_NAME=

# === OPTIONAL: claude flags ======================================

# Set to "1" to pass --dangerously-skip-permissions. Only safe in a
# truly sandboxed / throwaway container — Claude will run any tool
# call without asking. Default is "0" (permission prompts surface
# normally, which the operator resolves remotely via clawborrator).
CLAUDE_SKIP_PERMISSIONS=0

# Single prompt to feed claude at startup. Useful for batch /
# one-shot containers ("summarize this repo and exit"). Leave blank
# for interactive / clawborrator-driven sessions.
CLAUDE_INITIAL_PROMPT=
