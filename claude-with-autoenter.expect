#!/usr/bin/expect -f
# Auto-dismiss the API-key prompt (and the dev-channels prompt if
# it fires) on claude startup, then hand the PTY back.
#
# Single-expect design via `exp_continue`: keep matching prompts as
# they appear until we see the "Welcome" banner that means claude
# is past bootstrap. No fixed wait-for-second-prompt timeout tax.
#
# Two prompts handled:
#
#   1. "Detected a custom API key" — fires when ANTHROPIC_API_KEY
#      is set and the approval is not yet in ~/.claude.json (the
#      entrypoint seeds it, so this is a fallback). Default cursor
#      is on "No (recommended)", so we send Up + Enter to pick
#      "Yes". Sleeps around the keystrokes guard against Ink
#      stale-state. Claude Code >= 2.1 renders the prompt with
#      cursor-positioning escape codes between words
#      ("API[25Gkey"), so the pattern tolerates non-space
#      bytes between "API" and "key".
#
#   2. "WARNING: Loading development channels" — fires only when
#      --dangerously-load-development-channels is passed standalone
#      (NOT with a server: prefix). Default cursor is on option 1,
#      Enter confirms. As of channel_v1 + server:clawborrator this
#      prompt is suppressed and won't normally appear, but we
#      handle it anyway for forward-compat.
#
# Exit: when we see "Welcome" (the post-bootstrap banner — appears
# in "Welcome back!" / "Welcome back <name>!" / similar) we hand
# off via interact. 60s timeout fallback in case the banner is
# themed or claude renders something we don't recognize.

set timeout 60
log_user 1
# Answer the API-key prompt at most once: Ink re-renders the box on
# every cursor move, which would re-trigger the pattern and toggle
# the selection back to "No".
set api_answered 0

eval spawn claude $argv

expect {
  # Claude finished bootstrap — banner appeared. Stop dismissing
  # prompts; hand the PTY back. Match a single word (Ink interleaves
  # ANSI between words but not inside them).
  -re {Welcome|Claude[^ ]{0,16}Code[^ ]{0,16}v[0-9]} {
    # fall through to interact
  }

  -re {API[^ ]{0,16}key} {
    if {!$api_answered} {
      set api_answered 1
      sleep 0.5
      send "\033\[A"   ;# Up arrow — move cursor from "No" to "Yes"
      sleep 0.3
      send "\r"
    }
    exp_continue
  }

  -re "development" {
    sleep 0.2
    send "\r"
    exp_continue
  }

  timeout {
    # Banner never matched (claude may have a different banner
    # variant, or rendering was redirected). Fall through to
    # interact so the operator can finish whatever's pending.
  }

  eof {
    catch wait result
    exit [lindex $result 3]
  }
}

# Hand the PTY back. Channel-MCP notifications keep arriving in-band;
# nothing for the wrapper to do from here.
set timeout -1
interact
